{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"fonts": "node scripts/fonts.mjs",
		"predev": "npm run fonts",
		"dev": "vite dev",
		"prebuild": "npm run fonts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run fonts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:render": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"@types/three": "^0.186.0",
		"mdsvex": "^0.12.7",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"shiki": "^4.5.0",
		"simple-icons": "^13.21.0",
		"subset-font": "^2.9.0",
		"svelte": "^5.57.1",
		"svelte-5.0.0": "npm:svelte@5.0.0",
		"svelte-check": "^4.6.0",
		"three": "^0.186.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
